---
# Node 0 — Vault SSH CA (Start of workflow)
# Based on AWX team's playbook — corrected for 5-node workflow design
#
# Corrections vs original AWX team playbook:
# 1. run_once: true on all localhost tasks        — fixes race condition
# 2. delegate_to: localhost on ALL localhost tasks — fixes execution location
# 3. awx_job_id in key filename                  — prevents concurrent job collision
# 4. Removed host tasks                           — roles handle work in Nodes 1-3
# 5. Added set_stats at end                       — passes key paths downstream
# 6. Added vars mapping                           — lowercase credential to uppercase
# 7. Added error handling on Vault login          — clear failure messages
# 8. Added error handling on cert signing         — clear failure messages
# 9. Added cert file existence check              — validates write succeeded
# 10. Removed redundant creates: on ssh-keygen   — run_once handles idempotency
# 11. Added changed_when on ssh-keygen           — correct change reporting
# 12. Token in set_stats noted as known limit    — 1h TTL, limited policy

- name: Vault SSH CA — generate and sign ephemeral key
  hosts: all
  gather_facts: false

  vars:
    # Map credential-injected vars (lowercase) to playbook vars (uppercase)
    VAULT_ADDR: "{{ vault_addr }}"
    VAULT_ROLE_ID: "{{ vault_role_id }}"
    VAULT_SECRET_ID: "{{ vault_secret_id }}"
    VAULT_NAMESPACE: "{{ vault_namespace }}"

    # Playbook-specific vars
    ssh_key_path: "/runner/.ssh/vault_{{ awx_job_id }}_key"
    ssh_cert_path: "/runner/.ssh/vault_{{ awx_job_id }}_key-cert.pub"
    vault_ssh_user: "lnxawxsid"
    app_role_path: "approle-linux-team"

  tasks:

    ##################################################
    # 1. Prepare controller SSH directory
    ##################################################

    - name: Check if /home/runner already exists
      ansible.builtin.stat:
        path: /home/runner
      register: home_runner
      delegate_to: localhost
      run_once: true

    - name: Symlink /home/runner to /runner
      ansible.builtin.file:
        src: /runner
        dest: /home/runner
        state: link
      when: not home_runner.stat.exists
      delegate_to: localhost
      run_once: true

    - name: Ensure /runner/.ssh directory exists
      ansible.builtin.file:
        path: "/runner/.ssh"
        state: directory
        mode: '0700'
      delegate_to: localhost
      run_once: true

    ##################################################
    # 2. Generate ephemeral keypair
    ##################################################

    - name: Generate ephemeral SSH private key
      ansible.builtin.command:
        cmd: "ssh-keygen -t ed25519 -f {{ ssh_key_path }} -N ''"
      delegate_to: localhost
      run_once: true
      changed_when: true

    - name: Read public key
      ansible.builtin.slurp:
        src: "{{ ssh_key_path }}.pub"
      register: pubkey_raw
      delegate_to: localhost
      run_once: true

    - name: Decode public key
      ansible.builtin.set_fact:
        public_key: "{{ pubkey_raw.content | b64decode }}"
      delegate_to: localhost
      run_once: true

    ##################################################
    # 3. Authenticate to Vault via AppRole
    ##################################################

    - name: Login to Vault using AppRole
      ansible.builtin.uri:
        url: "{{ VAULT_ADDR }}/v1/auth/{{ app_role_path }}/login"
        method: POST
        body_format: json
        body:
          role_id: "{{ VAULT_ROLE_ID }}"
          secret_id: "{{ VAULT_SECRET_ID }}"
        headers:
          X-Vault-Namespace: "{{ VAULT_NAMESPACE }}"
        validate_certs: true
        return_content: true
        status_code: 200
      register: vault_login
      delegate_to: localhost
      run_once: true
      no_log: true
      failed_when: vault_login.status != 200

    - name: Fail clearly if Vault login unsuccessful
      ansible.builtin.fail:
        msg: >
          Vault AppRole login failed.
          Check VAULT_ADDR, VAULT_ROLE_ID, VAULT_SECRET_ID
          and VAULT_NAMESPACE in sscm_linux_team_vault credential.
          HTTP status: {{ vault_login.status }}
      when: vault_login.json.auth is not defined
      delegate_to: localhost
      run_once: true

    - name: Extract Vault token
      ansible.builtin.set_fact:
        vault_token: "{{ vault_login.json.auth.client_token }}"
      delegate_to: localhost
      run_once: true
      no_log: true

    ##################################################
    # 4. Sign public key via Vault SSH CA
    ##################################################

    - name: Request SSH certificate from Vault
      ansible.builtin.uri:
        url: "{{ VAULT_ADDR }}/v1/ssh/sign/linux-server-role"
        method: POST
        body_format: json
        headers:
          X-Vault-Token: "{{ vault_token }}"
          X-Vault-Namespace: "{{ VAULT_NAMESPACE }}"
        body:
          public_key: "{{ public_key }}"
          valid_principals: "{{ vault_ssh_user }}"
        validate_certs: true
        return_content: true
        status_code: 200
      register: signed_cert_response
      delegate_to: localhost
      run_once: true

    - name: Fail clearly if certificate signing unsuccessful
      ansible.builtin.fail:
        msg: >
          Vault SSH certificate signing failed.
          Check SSH role name (linux-server-role) and
          valid_principals ({{ vault_ssh_user }}) with Vault team.
          HTTP status: {{ signed_cert_response.status }}
      when: signed_cert_response.json.data is not defined
      delegate_to: localhost
      run_once: true

    - name: Write signed certificate to file
      ansible.builtin.copy:
        content: "{{ signed_cert_response.json.data.signed_key }}"
        dest: "{{ ssh_cert_path }}"
        mode: '0644'
      delegate_to: localhost
      run_once: true

    ##################################################
    # 5. Verify certificate was written correctly
    ##################################################

    - name: Verify certificate file exists
      ansible.builtin.stat:
        path: "{{ ssh_cert_path }}"
      register: cert_file
      delegate_to: localhost
      run_once: true

    - name: Fail if certificate file was not written
      ansible.builtin.fail:
        msg: "SSH certificate was not written to {{ ssh_cert_path }} — cannot proceed"
      when: not cert_file.stat.exists
      delegate_to: localhost
      run_once: true

    - name: Verify certificate details
      ansible.builtin.command:
        cmd: "ssh-keygen -L -f {{ ssh_cert_path }}"
      register: cert_details
      delegate_to: localhost
      run_once: true
      changed_when: false

    - name: Display certificate info
      ansible.builtin.debug:
        msg: "{{ cert_details.stdout_lines }}"
      delegate_to: localhost
      run_once: true

    ##################################################
    # 6. Pass key paths to downstream nodes
    ##################################################

    - name: Pass key paths to downstream nodes via set_stats
      ansible.builtin.set_stats:
        data:
          vault_ssh_key_path: "{{ ssh_key_path }}"
          vault_ssh_cert_path: "{{ ssh_cert_path }}"
          # vault_token_to_revoke visible in AWX artifacts
          # Acceptable — 1h TTL, awx-policy limits to sign + read CA only
          vault_token_to_revoke: "{{ vault_token }}"
        per_host: false
      delegate_to: localhost
      run_once: true
